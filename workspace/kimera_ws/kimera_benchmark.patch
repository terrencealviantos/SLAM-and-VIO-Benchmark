diff --git a/include/kimera-vio/utils/ScopedTiming.h b/include/kimera-vio/utils/ScopedTiming.h
new file mode 100644
index 00000000..f0e8f1a3
--- /dev/null
+++ b/include/kimera-vio/utils/ScopedTiming.h
@@ -0,0 +1,68 @@
+/**
+ * Benchmark instrumentation (not part of upstream Kimera-VIO).
+ *
+ * One CSV row per module execution with real start/end timestamps, same layout as the
+ * OpenVINS / ORB-SLAM3 logs of this benchmark:
+ *     frame_id,module,thread_id,start_ns,end_ns,duration_ms
+ * Recorded in PipelineModule::spin() around spinOnce(), i.e. exactly the interval Kimera
+ * itself measures for its "<module> [ms]" statistics. frame_id is the timestamp [ns] of
+ * the packet being processed (the camera frame), or -1 if the payload has none.
+ * Timestamps come from std::chrono::steady_clock (only differences are meaningful).
+ *
+ * Output path: $KIMERA_TIMING_CSV, or kimera_scoped_timing.csv in the working directory.
+ */
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <iomanip>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace VIO {
+
+class TimingLog {
+ public:
+  static void record(const std::string& module,
+                     long long frame_id,
+                     const std::chrono::steady_clock::time_point& start,
+                     const std::chrono::steady_clock::time_point& end) {
+    static TimingLog log;  // opened on first use
+    log.write(module, frame_id, start, end);
+  }
+
+ private:
+  TimingLog() {
+    const char* path = std::getenv("KIMERA_TIMING_CSV");
+    ofs_.open(path ? path : "kimera_scoped_timing.csv",
+              std::ios::out | std::ios::trunc);
+    ofs_ << "frame_id,module,thread_id,start_ns,end_ns,duration_ms\n";
+  }
+
+  void write(const std::string& module,
+             long long frame_id,
+             const std::chrono::steady_clock::time_point& start,
+             const std::chrono::steady_clock::time_point& end) {
+    using std::chrono::duration_cast;
+    using std::chrono::nanoseconds;
+    const long long start_ns =
+        duration_cast<nanoseconds>(start.time_since_epoch()).count();
+    const long long end_ns =
+        duration_cast<nanoseconds>(end.time_since_epoch()).count();
+    const size_t thread_id =
+        std::hash<std::thread::id>()(std::this_thread::get_id());
+    std::lock_guard<std::mutex> lock(mtx_);
+    ofs_ << frame_id << ',' << module << ',' << thread_id << ',' << start_ns
+         << ',' << end_ns << ',' << std::fixed << std::setprecision(4)
+         << (end_ns - start_ns) * 1e-6 << '\n';
+    ofs_.flush();
+  }
+
+  std::ofstream ofs_;
+  std::mutex mtx_;
+};
+
+}  // namespace VIO
