diff --git a/include/ScopedTiming.h b/include/ScopedTiming.h
new file mode 100644
index 0000000..8c5c46d
--- /dev/null
+++ b/include/ScopedTiming.h
@@ -0,0 +1,69 @@
+/**
+ * Benchmark instrumentation (not part of upstream ORB-SLAM3).
+ *
+ * Writes one CSV row per measured module execution with real start/end timestamps, in
+ * the same layout as OpenVINS' ov_scoped_timing.csv:
+ *     frame_id,module,thread_id,start_ns,end_ns,duration_ms
+ * Rows are recorded at ORB-SLAM3's own REGISTER_TIMES measurement points, so the module
+ * boundaries are exactly the ones ORB-SLAM3 itself uses for its timing statistics.
+ * frame_id is Frame::mnId (one per stereo image); local mapping and loop closing rows use
+ * the frame that created the keyframe being processed (KeyFrame::mnFrameId).
+ * Timestamps come from std::chrono::steady_clock (only differences are meaningful).
+ *
+ * Output path: $ORB_SLAM3_TIMING_CSV, or orbslam3_scoped_timing.csv in the working dir.
+ */
+#ifndef ORB_SLAM3_SCOPED_TIMING_H
+#define ORB_SLAM3_SCOPED_TIMING_H
+
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <iomanip>
+#include <mutex>
+#include <thread>
+
+namespace ORB_SLAM3
+{
+
+class TimingLog
+{
+public:
+    static void record(const char *module, long frame_id,
+                       const std::chrono::steady_clock::time_point &start,
+                       const std::chrono::steady_clock::time_point &end)
+    {
+        static TimingLog log;  // opened on first use
+        log.write(module, frame_id, start, end);
+    }
+
+private:
+    TimingLog()
+    {
+        const char *path = std::getenv("ORB_SLAM3_TIMING_CSV");
+        ofs_.open(path ? path : "orbslam3_scoped_timing.csv", std::ios::out | std::ios::trunc);
+        ofs_ << "frame_id,module,thread_id,start_ns,end_ns,duration_ms\n";
+    }
+
+    void write(const char *module, long frame_id,
+               const std::chrono::steady_clock::time_point &start,
+               const std::chrono::steady_clock::time_point &end)
+    {
+        using std::chrono::duration_cast;
+        using std::chrono::nanoseconds;
+        const long long start_ns = duration_cast<nanoseconds>(start.time_since_epoch()).count();
+        const long long end_ns = duration_cast<nanoseconds>(end.time_since_epoch()).count();
+        const size_t thread_id = std::hash<std::thread::id>()(std::this_thread::get_id());
+        std::lock_guard<std::mutex> lock(mtx_);
+        ofs_ << frame_id << ',' << module << ',' << thread_id << ',' << start_ns << ',' << end_ns << ','
+             << std::fixed << std::setprecision(4) << (end_ns - start_ns) * 1e-6 << '\n';
+        ofs_.flush();
+    }
+
+    std::ofstream ofs_;
+    std::mutex mtx_;
+};
+
+} // namespace ORB_SLAM3
+
+#endif // ORB_SLAM3_SCOPED_TIMING_H
